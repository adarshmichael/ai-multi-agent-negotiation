# Environment variables for NegoSim backend
# Copy this file to .env and fill in your values. Never commit .env.

# ---- Required ----
GEMINI_API_KEY=YOUR_API_KEY_HERE        # Your Google Gemini API key (get at https://aistudio.google.com)

# ---- Optional ----
PORT=8001                # Port for the backend server (must match frontend api.js BASE_URL)
MAX_ROUNDS=10            # Default maximum negotiation rounds
THINK_DELAY_MS=2000      # Milliseconds between agent messages (makes it feel live)
NODE_ENV=development     # development | production
