# Environment variables for NegoSim backend
# Copy this file to .env and fill in your values. NEVER commit .env.

# ---- Required ----
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE   # Get at https://aistudio.google.com

# ---- Optional server config ----
PORT=8001                # Port for the backend server
MAX_ROUNDS=10            # Default maximum negotiation rounds
THINK_DELAY_MS=2000      # Milliseconds between agent messages
NODE_ENV=development     # development | production

# ---- Authentication (MongoDB + JWT) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/negosim?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-long-random-string-64-chars-minimum  # See README for how to generate
JWT_EXPIRY=7d

# ---- CORS: comma-separated extra allowed origins (no trailing slash) ----
# The following are always allowed by default:
#   https://adarshmichael.github.io
#   http://127.0.0.1:5501  http://localhost:5501  http://localhost:3000
CLIENT_ORIGINS=

# ---- Google OAuth (optional — leave empty to disable) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
